#: data/de.haeckerfelix.Shortwave.metainfo.xml.in.in:12
msgid ""
"@NAME@ is an internet radio player that provides access to a station "
"database with over 50,000 stations."
msgstr ""
"@NAME@, 50.000’i aşkın istasyon barındıran veri tabanına erişmenizi sağlayan "
"internet radyo oynatıcısıdır."

